{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyEd",
  "version": "../package.json",
  "identifier": "io.github.urands.keyed",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KeyEd",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self'",
        "font-src": "'self'",
        "style-src": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5QUIzQjE1Njk4QkUyNkMKUldSczRvdHBGVHVyNmVIWmFqeGhiL3NUaGV1WmNyRlp4cG56QmNqdVpxNzFXMkxNWVF5TGY5MVkK",
      "endpoints": ["https://github.com/urands/keyed/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "category": "Education",
    "shortDescription": "Touch typing tutor",
    "longDescription": "KeyEd teaches touch typing on the English QWERTY and Russian ЙЦУКЕН layouts with adaptive lessons.",
    "copyright": "© 2026 KeyEd contributors. MIT License.",
    "homepage": "https://urands.github.io/keyed/",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.3"
    },
    "linux": {
      "deb": {
        "section": "education"
      }
    }
  }
}
